# ===========================
# GLOBAL / SECRETS (Crucial)
# ===========================
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.log

# Block Google/Firebase Keys (Based on your project)
service-account-key.json
google-credentials.json
firebase-config.js

# ===========================
# CLIENT (React Native / Expo)
# ===========================
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

# Native - Path corrected for your "client" folder
client/ios/
client/android/

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# TypeScript
*.tsbuildinfo
app-example

# ===========================
# SERVER (Python / Flask)
# ===========================
# Python cache (Junk files)
__pycache__/
*.pyc

# Virtual Environment (Very important to ignore)
venv/
env/
.venv/

# User Uploads (Invoices)
server/uploads/