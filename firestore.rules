rules_version = '2';

// All reads and writes go through the SmartBill server, which uses the Admin SDK
// (Admin SDK access is not affected by these rules). The mobile app never talks
// to Firestore directly, so every direct client request is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
